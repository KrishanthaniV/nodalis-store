# ============================================================
# NODALIS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/nodalis

# JWT Secret — change this to a random secure string!
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRES_IN=7d

# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# PayPal (get keys from https://developer.paypal.com)
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
PAYPAL_MODE=sandbox
